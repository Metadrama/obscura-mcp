{
    "name": "obscura-mcp",
    "version": "0.1.1",
    "mcpName": "io.github.Metadrama/obscura-mcp",
  "description": "MCP server adapter for Obscura headless browser - high-performance web scraping with anti-detection",
  "main": "index.js",
  "scripts": {
    "test": "node -e \"console.log('No automated tests configured yet')\"",
    "start": "node index.js --transport stdio",
    "postinstall": "node scripts/postinstall.js"
  },
  "bin": {
    "obscura-mcp": "index.js",
    "obscura": "scripts/obscura-bin.js"
  },
  "keywords": [
    "mcp",
    "obscura",
    "headless-browser",
    "web-scraping",
    "ai-agents",
    "model-context-protocol"
  ],
