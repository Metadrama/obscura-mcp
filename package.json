  },
  "homepage": "https://github.com/Metadrama/0bscura-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "optionalDependencies": {
    "puppeteer-core": "^24.42.0"
  }
