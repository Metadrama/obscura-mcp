    "url": "https://github.com/Metadrama/0bscura-mcp"
  },
  "bugs": {
    "url": "https://github.com/Metadrama/0bscura-mcp/issues"
  },
  "homepage": "https://github.com/Metadrama/0bscura-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tar": "^7.1.1",
    "ws": "^8.20.0",
    "yauzl": "^3.1.3"
  }
}
