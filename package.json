{
  "name": "obscura-mcp",
  "version": "0.1.4-3",
  "mcpName": "io.github.Metadrama/obscura-mcp",
  "description": "MCP server adapter for Obscura headless browser - high-performance web scraping with anti-detection",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "scripts/",
    "server.json",
    "Dockerfile",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp package.json dist/ && cp -r scripts dist/",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js --transport stdio"
  },
  "bin": {
    "obscura-mcp": "dist/index.js",
    "obscura": "scripts/obscura-bin.js"
  },
  "keywords": [
    "mcp",
    "obscura",
    "headless-browser",
    "web-scraping",
    "ai-agents",
    "model-context-protocol"
  ],
  "author": "Metadrama",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metadrama/obscura-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Metadrama/obscura-mcp/issues"
  },
  "homepage": "https://github.com/Metadrama/obscura-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tar": "^7.1.1",
    "ws": "^8.20.0",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
