{
  "name": "mcp-obscura",
  "version": "1.0.3",
  "description": "MCP server adapter for Obscura headless browser - high-performance web scraping with anti-detection",
  "main": "index.js",
  "scripts": {
    "test": "node -e \"console.log('No automated tests configured yet')\"",
    "start": "node index.js --transport stdio",
